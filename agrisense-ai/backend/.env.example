# ─── AgriSense AI Backend — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your actual values

# JWT Secret (change this to a long random string in production)
JWT_SECRET=supersecretjwtkey_agrisense_change_me

# ─── Email (SMTP) — for Password Reset Emails ──────────────────────────────────
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
# Enable 2-Factor Auth first, then generate an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx       # ← your 16-char Gmail App Password

# ─── Frontend URL (used in reset email link) ────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── AI Service URL ─────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001
